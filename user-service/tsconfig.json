{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": "..",
    "rootDir": "..",
    "paths": {
      "@/*": ["user-service/src/*"],
      "@config/*": ["user-service/src/config/*"],
      "@api/*": ["user-service/src/api/*"],
      "@domain/*": ["user-service/src/domain/*"],
      "@middlewares/*": ["user-service/src/middlewares/*"],
      "@utils/*": ["user-service/src/utils/*"],
      "@types/*": ["user-service/src/types/*"]
    }
  },
  "include": ["src/**/*", "../shared/**/*"],
  "exclude": ["node_modules", "dist"]
}
