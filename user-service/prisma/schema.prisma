generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ==================== USER MODEL ====================

model User {
  id               String  @id @default(auto()) @map("_id") @db.ObjectId
  githubId         String? @unique @map("github_id")
  googleId         String? @unique @map("google_id")
  username         String  @unique
  email            String? @unique
  name             String?
  avatarUrl        String? @map("avatar_url")
  bio              String?
  location         String?
  company          String?
  website          String?
  twitterHandle    String? @map("twitter_handle")
  leetcodeUsername String? @map("leetcode_username")

  // ========== STUDENT INFO ==========
  isStudent      Boolean @default(false) @map("is_student")
  collegeName    String? @map("college_name")
  collegeYear    Int?    @map("college_year") // 1, 2, 3, 4
  branch         String? // Computer Science, IT, etc.
  cgpa           Float?  @map("cgpa")
  graduationYear Int?    @map("graduation_year")

  // ========== ONBOARDING STATUS ==========
  onboardingComplete Boolean @default(false) @map("onboarding_complete")
  onboardingStep     Int     @default(0) @map("onboarding_step") // 0-4

  // ========== PROFILE VISIBILITY ==========
  isPublic        Boolean         @default(true) @map("is_public")
  isOpenToWork    Boolean         @default(false) @map("is_open_to_work")
  isVerified      Boolean         @default(false) @map("is_verified")
  showEmail       Boolean         @default(false) @map("show_email")
  showCgpa        Boolean         @default(false) @map("show_cgpa")
  showPhone       Boolean         @default(false) @map("show_phone")
  visibilityLevel VisibilityLevel @default(RECRUITERS_ONLY) @map("visibility_level")

  // ========== JOB PREFERENCES ==========
  preferredRoles     String[]         @default([]) @map("preferred_roles") // ["Backend Dev", "Full Stack"]
  preferredLocations String[]         @default([]) @map("preferred_locations") // ["Remote", "Bangalore"]
  preferredJobTypes  String[]         @default([]) @map("preferred_job_types") // ["FULL_TIME", "CONTRACT"]
  expectedSalaryMin  Int?             @map("expected_salary_min") // In INR/USD
  expectedSalaryMax  Int?             @map("expected_salary_max")
  salaryCurrency     String?          @default("INR") @map("salary_currency")
  availableFrom      DateTime?        @map("available_from")
  noticePeriodDays   Int?             @default(0) @map("notice_period_days")
  remotePreference   RemotePreference @default(FLEXIBLE) @map("remote_preference")

  // ========== HIGHLIGHTED CONTENT ==========
  highlightedSkills String[] @default([]) @map("highlighted_skills") // Top skills to show recruiters
  phone             String?  @map("phone")

  // ========== AURA & STATS ==========
  auraScore           Int @default(0) @map("aura_score")
  coreCount           Int @default(1) @map("core_count")
  githubFollowers     Int @default(0) @map("github_followers")
  githubRepos         Int @default(0) @map("github_repos")
  githubContributions Int @default(0) @map("github_contributions")

  // ========== DEVELOPER ROLE & NICHE (SYSTEM-INFERRED) ==========
  // Primary role is auto-inferred from project analysis - cannot be edited
  primaryRole     String?         @map("primary_role") // "Backend Developer", "Full Stack Engineer", etc.
  primaryNiche    DeveloperNiche? @map("primary_niche") // Domain categorization
  secondaryNiche  DeveloperNiche? @map("secondary_niche") // Backup domain
  nicheConfidence Int             @default(0) @map("niche_confidence") // 0-100 system confidence
  nicheInferredAt DateTime?       @map("niche_inferred_at")
  // System-generated tags (non-editable)
  autoTags        String[]        @default([]) @map("auto_tags") // ["Backend Developer", "Infrastructure Aware"]

  // ========== TIMESTAMPS ==========
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  lastLoginAt       DateTime? @map("last_login_at")
  githubAccessToken String?   @map("github_access_token")

  // ========== RELATIONS ==========
  sessions      Session[]
  skills        Skill[]
  technologies  Technology[]
  projects      Project[]
  experiences   Experience[]
  socialLinks   SocialLink[]
  activities    Activity[]
  applications  Application[]
  savedJobs     SavedJob[]
  jobAlerts     JobAlert[]
  notifications Notification[]
  auraScoreData AuraScore? // One-to-one relationship

  @@index([auraScore])
  @@index([isOpenToWork])
  @@index([isStudent])
  @@index([onboardingComplete])
  @@index([createdAt])
  @@index([primaryNiche])
  @@map("users")
}

// ==================== SESSION MODEL ====================

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String   @map("user_id") @db.ObjectId
  refreshToken String   @unique @map("refresh_token")
  userAgent    String?  @map("user_agent")
  ipAddress    String?  @map("ip_address")
  isValid      Boolean  @default(true) @map("is_valid")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([isValid])
  @@map("sessions")
}

// ==================== SKILL MODEL ====================

model Skill {
  id       String        @id @default(auto()) @map("_id") @db.ObjectId
  userId   String        @map("user_id") @db.ObjectId
  name     String
  category SkillCategory @default(OTHER)

  // ========== SKILL SOURCE & VERIFICATION ==========
  source        SkillSource @default(MANUAL) // Where did this skill come from?
  isVerified    Boolean     @default(false) @map("is_verified")
  verifiedScore Int         @default(0) @map("verified_score") // 0-100 score
  verifiedAt    DateTime?   @map("verified_at")

  // Evidence for verified skills (JSON array of project IDs, commit counts, etc.)
  evidence Json? @default("[]")

  // Self-declared for manual skills
  selfDeclaredLevel SkillLevel @default(BEGINNER) @map("self_declared_level")

  // ========== STATS ==========
  projectCount     Int @default(0) @map("project_count")
  linesOfCode      Int @default(0) @map("lines_of_code")
  auraContribution Int @default(0) @map("aura_contribution")

  // ========== VISIBILITY ==========
  isHighlighted    Boolean @default(false) @map("is_highlighted") // Show in top skills
  showToRecruiters Boolean @default(true) @map("show_to_recruiters") // Show in recruiter view

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
  @@index([source])
  @@index([category])
  @@index([isVerified])
  @@index([name])
  @@map("skills")
}

// Where did the skill come from?
enum SkillSource {
  GITHUB // Auto-detected from GitHub repos (languages, etc.)
  ANALYSIS // Verified through project analyzer (protected - can't edit)
  MANUAL // User-declared (unverified, can edit/delete)
}

enum SkillCategory {
  // Core categories
  LANGUAGE         @map("language")
  LANGUAGE_LEGACY  @map("LANGUAGE")
  FRAMEWORK        @map("framework")
  FRAMEWORK_LEGACY @map("FRAMEWORK")
  LIBRARY          @map("library")
  LIBRARY_LEGACY   @map("LIBRARY")
  DATABASE         @map("database")
  DATABASE_LEGACY  @map("DATABASE")

  // DevOps & Infrastructure
  DEVOPS                  @map("devops")
  DEVOPS_LEGACY           @map("DEVOPS")
  INFRASTRUCTURE          @map("infrastructure")
  INFRASTRUCTURE_LEGACY   @map("INFRASTRUCTURE")
  WEBSERVER               @map("webserver")
  WEBSERVER_LEGACY        @map("WEBSERVER")
  CI_CD                   @map("ci_cd")
  CI_CD_LEGACY            @map("CI_CD")
  CONTAINERIZATION        @map("containerization")
  CONTAINERIZATION_LEGACY @map("CONTAINERIZATION")
  ORCHESTRATION           @map("orchestration")
  ORCHESTRATION_LEGACY    @map("ORCHESTRATION")
  CLOUD                   @map("cloud")
  CLOUD_LEGACY            @map("CLOUD")

  // Tools & Testing
  TOOL              @map("tool")
  TOOL_LEGACY       @map("TOOL")
  TESTING           @map("testing")
  TESTING_LEGACY    @map("TESTING")
  BUILD_TOOL        @map("build_tool")
  BUILD_TOOL_LEGACY @map("BUILD_TOOL")
  LINTING           @map("linting")
  LINTING_LEGACY    @map("LINTING")

  // Messaging & Caching
  MESSAGING        @map("messaging")
  MESSAGING_LEGACY @map("MESSAGING")
  CACHE            @map("cache")
  CACHE_LEGACY     @map("CACHE")
  SEARCH           @map("search")
  SEARCH_LEGACY    @map("SEARCH")

  // Architecture & Patterns
  ARCHITECTURE        @map("architecture")
  ARCHITECTURE_LEGACY @map("ARCHITECTURE")

  // Machine Learning & AI
  ML        @map("ml")
  ML_LEGACY @map("ML")

  // Observability & Monitoring
  OBSERVABILITY        @map("observability")
  OBSERVABILITY_LEGACY @map("OBSERVABILITY")

  // Patterns
  PATTERN        @map("pattern")
  PATTERN_LEGACY @map("PATTERN")

  // Optimization categories (from aura-calculator)
  PERFORMANCE          @map("performance")
  PERFORMANCE_LEGACY   @map("PERFORMANCE")
  SECURITY             @map("security")
  SECURITY_LEGACY      @map("SECURITY")
  STRUCTURE            @map("structure")
  STRUCTURE_LEGACY     @map("STRUCTURE")
  DOCUMENTATION        @map("documentation")
  DOCUMENTATION_LEGACY @map("DOCUMENTATION")

  // Soft skills
  SOFT_SKILL
  OTHER
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

// ==================== TECHNOLOGY MODEL ====================

model Technology {
  id       String             @id @default(auto()) @map("_id") @db.ObjectId
  userId   String             @map("user_id") @db.ObjectId
  name     String
  category TechnologyCategory @default(OTHER)

  // ========== DETECTION INFO ==========
  detectedFrom String[] @default([]) @map("detected_from") // e.g., ["docker", "terraform", "ansible"]
  confidence   Int      @default(0) // 0-100

  // ========== USAGE STATS ==========
  projectCount     Int @default(0) @map("project_count")
  auraContribution Int @default(0) @map("aura_contribution")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
  @@index([category])
  @@index([name])
  @@map("technologies")
}

enum TechnologyCategory {
  INFRASTRUCTURE // Docker, K8s, Terraform
  CICD // GitHub Actions, Jenkins, CircleCI
  MONITORING // Prometheus, Grafana, DataDog
  CLOUD // AWS, GCP, Azure
  SECURITY // OAuth, JWT, SSL
  OTHER
}

// ==================== PROJECT MODEL ====================

model Project {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @map("user_id") @db.ObjectId

  // ========== GITHUB INFO ==========
  githubRepoUrl String  @map("github_repo_url")
  repoName      String  @map("repo_name")
  description   String?
  stars         Int     @default(0)
  forks         Int     @default(0)
  language      String? // Primary language

  // ========== ANALYSIS ==========
  analysisStatus AnalysisStatus @default(PENDING) @map("analysis_status")
  analyzedAt     DateTime?      @map("analyzed_at")
  basePath       String?        @map("base_path") // Subfolder path for analysis (e.g. /backend)

  // ========== SCORES ==========
  codeQualityScore Int @default(0) @map("code_quality_score")
  structureScore   Int @default(0) @map("structure_score")
  overallScore     Int @default(0) @map("overall_score")
  auraContribution Int @default(0) @map("aura_contribution")

  // ========== VISIBILITY ==========
  isPublic          Boolean @default(true) @map("is_public")
  isPinned          Boolean @default(false) @map("is_pinned")
  displayOrder      Int     @default(0) @map("display_order")
  showToRecruiters  Boolean @default(true) @map("show_to_recruiters") // Show in recruiter search
  customDescription String? @map("custom_description") // Override GitHub description

  // ========== PROJECT NICHE (USER INPUT) ==========
  // User selects this when adding project - helps analyzer focus on relevant signals
  projectNiche DeveloperNiche? @map("project_niche")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // ========== RELATIONS ==========
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysis   ProjectAnalysis? // Detailed analysis in separate collection
  gitDetails ProjectGitDetails? // GitHub-sourced git data

  @@unique([userId, githubRepoUrl])
  @@index([userId])
  @@index([analysisStatus])
  @@index([isPinned])
  @@index([createdAt])
  @@index([overallScore])
  @@map("projects")
}

enum AnalysisStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// ==================== PROJECT GIT DETAILS (from GitHub APIs) ====================
// Replaces the Go engine's local git forensics with real GitHub data

model ProjectGitDetails {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  projectId String @unique @map("project_id") @db.ObjectId

  // ========== COMMIT HISTORY ==========
  totalCommits    Int       @default(0) @map("total_commits")
  firstCommitDate DateTime? @map("first_commit_date")
  lastCommitDate  DateTime? @map("last_commit_date")
  commitFrequency Json?     @map("commit_frequency") // Weekly commit counts [{week, total}]

  // ========== CONTRIBUTORS ==========
  totalContributors Int   @default(0) @map("total_contributors")
  contributors      Json? // [{login, avatar, commits, additions, deletions}]
  primaryAuthorPct  Float @default(0) @map("primary_author_pct")

  // ========== REPO STATS ==========
  stars      Int @default(0)
  forks      Int @default(0)
  watchers   Int @default(0)
  openIssues Int @default(0) @map("open_issues")
  repoSize   Int @default(0) @map("repo_size") // KB

  // ========== LANGUAGE BREAKDOWN (from GitHub) ==========
  languageBreakdown Json? @map("language_breakdown") // {TypeScript: 50000, Go: 30000}

  // ========== ACTIVITY ==========
  isActive         Boolean   @default(true) @map("is_active")
  lastActivityDate DateTime? @map("last_activity_date")

  // ========== METADATA ==========
  fetchedAt DateTime @default(now()) @map("fetched_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_git_details")
}

// ==================== PROJECT ANALYSIS MODEL (STRUCTURED) ====================
// Complete structured schema - NO JSON fields!
// All analysis data as proper database fields for better querying and performance

model ProjectAnalysis {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  projectId String @unique @map("project_id") @db.ObjectId

  // ========== METADATA ==========
  analyzerVersion String   @default("2.0.0") @map("analyzer_version")
  processingTime  Int?     @map("processing_time") // milliseconds
  analyzedAt      DateTime @default(now()) @map("analyzed_at")

  // ========== FOLDER STRUCTURE ==========
  hasSrcFolder      Boolean  @default(false) @map("has_src_folder")
  hasComponents     Boolean  @default(false) @map("has_components")
  hasUtils          Boolean  @default(false) @map("has_utils")
  hasTests          Boolean  @default(false) @map("has_tests")
  hasTypes          Boolean  @default(false) @map("has_types")
  hasConfig         Boolean  @default(false) @map("has_config")
  hasDocs           Boolean  @default(false) @map("has_docs")
  hasApi            Boolean  @default(false) @map("has_api")
  hasServices       Boolean  @default(false) @map("has_services")
  hasModels         Boolean  @default(false) @map("has_models")
  hasMiddleware     Boolean  @default(false) @map("has_middleware")
  hasControllers    Boolean  @default(false) @map("has_controllers")
  organizationScore Int      @default(0) @map("organization_score")
  maxDepth          Int      @default(0) @map("max_depth")
  topLevelFolders   String[] @default([]) @map("top_level_folders")

  // ========== CODE QUALITY SIGNALS ==========
  hasReadme        Boolean @default(false) @map("has_readme")
  hasLicense       Boolean @default(false) @map("has_license")
  hasGitignore     Boolean @default(false) @map("has_gitignore")
  hasEnvExample    Boolean @default(false) @map("has_env_example")
  hasDockerfile    Boolean @default(false) @map("has_dockerfile")
  hasDockerCompose Boolean @default(false) @map("has_docker_compose")
  hasCI            Boolean @default(false) @map("has_ci")
  ciPlatform       String? @map("ci_platform") // "GitHub Actions", "GitLab CI", etc.
  hasLinting       Boolean @default(false) @map("has_linting")
  hasPrettier      Boolean @default(false) @map("has_prettier")
  hasTypeScript    Boolean @default(false) @map("has_typescript")
  hasMakefile      Boolean @default(false) @map("has_makefile")
  testFilesCount   Int     @default(0) @map("test_files_count")
  commentDensity   Int     @default(0) @map("comment_density")

  // ========== PROJECT METRICS ==========
  totalLines      Int    @default(0) @map("total_lines")
  totalFiles      Int    @default(0) @map("total_files")
  primaryLanguage String @default("Unknown") @map("primary_language")

  // ========== TECH STACK ==========
  languages      String[] @default([]) // ["TypeScript", "JavaScript"]
  frameworks     String[] @default([]) // ["React", "Express"]
  databases      String[] @default([]) // ["MongoDB", "Redis"]
  tools          String[] @default([]) // ["Docker", "Vite"]
  infrastructure String[] @default([]) // ["Nginx", "RabbitMQ"]

  // ========== ARCHITECTURE ==========
  architectureType          ArchitectureType? @map("architecture_type")
  serviceCount              Int               @default(0) @map("service_count")
  hasAPIGateway             Boolean           @default(false) @map("has_api_gateway")
  hasMessageQueue           Boolean           @default(false) @map("has_message_queue")
  hasSharedLibraries        Boolean           @default(false) @map("has_shared_libraries")
  engineeringLevel          EngineeringLevel? @map("engineering_level")
  architectureCommunication String[]          @default([]) @map("architecture_communication")
  architecturePatterns      String[]          @default([]) @map("architecture_patterns")
  architectureServiceNames  String[]          @default([]) @map("architecture_service_names")
  architectureGateway       String?           @map("architecture_gateway")
  infraSignalNames          String[]          @default([]) @map("infra_signal_names")

  // ========== BEST PRACTICES ==========
  bestPracticesFollowed String[] @default([]) @map("best_practices_followed")
  bestPracticesMissing  String[] @default([]) @map("best_practices_missing")
  bestPracticesScore    Int      @default(0) @map("best_practices_score")

  // ========== SCORES (from breakdown) ==========
  structureScore     Int @default(0) @map("structure_score")
  codeQualityScore   Int @default(0) @map("code_quality_score")
  testingScore       Int @default(0) @map("testing_score")
  documentationScore Int @default(0) @map("documentation_score")
  techStackScore     Int @default(0) @map("tech_stack_score")
  complexityScore    Int @default(0) @map("complexity_score")
  industryBonus      Int @default(0) @map("industry_bonus")
  projectTypeBonus   Int @default(0) @map("project_type_bonus")

  // ========== DIMENSIONAL ANALYSIS (from Go: pkg/dimensions) ==========
  // Dimension Scores (0-100) - MUST MATCH aura-processor schema!
  fundamentalsScore             Int?   @map("fundamentals_score")
  fundamentalsConfidence        Float? @map("fundamentals_confidence")
  engineeringDepthScore         Int?   @map("engineering_depth_score")
  engineeringDepthConfidence    Float? @map("engineering_depth_confidence")
  productionReadinessScore      Int?   @map("production_readiness_score")
  productionReadinessConfidence Float? @map("production_readiness_confidence")
  testingMaturityScore          Int?   @map("testing_maturity_score")
  testingMaturityConfidence     Float? @map("testing_maturity_confidence")
  architectureScore             Int?   @map("architecture_dimension_score")
  architectureConfidence        Float? @map("architecture_confidence")
  infraDevOpsScore              Int?   @map("infra_devops_score")
  infraDevOpsConfidence         Float? @map("infra_devops_confidence")

  // ========== AI VERDICT (Gemini) ==========
  aiVerdictTitle       String?  @map("ai_verdict_title")
  aiVerdictSummary     String?  @map("ai_verdict_summary")
  aiVerdictStrengths   String[] @default([]) @map("ai_verdict_strengths")
  aiVerdictWeaknesses  String[] @default([]) @map("ai_verdict_weaknesses")
  aiHireRecommendation String?  @map("ai_hire_recommendation") // STRONG_HIRE, HIRE, MAYBE, NO
  aiRiskScore          Int?     @map("ai_risk_score")
  aiRiskAnalysis       String?  @map("ai_risk_analysis")
  aiSkillsNarrative    String?  @map("ai_skills_narrative")
  aiInterviewQuestions String[] @default([]) @map("ai_interview_questions")

  // Trust Analysis (from Go: pkg/trust)
  trustLevel        TrustLevel?  @map("trust_level")
  trustScore        Int?         @map("trust_score")
  effortClass       EffortClass? @map("effort_class")
  authenticityScore Int?         @map("authenticity_score")
  authenticityFlags String[]     @default([]) @map("authenticity_flags")
  hasOriginalWork   Boolean?     @map("has_original_work")

  // ========== RELATIONS ==========
  project                 Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  verifiedSkills          AnalysisVerifiedSkill[]
  optimizationSuggestions AnalysisOptimization[]
  reactAnalysis           ReactAnalysis?
  languageStats           AnalysisLanguageStat[]
  infraSignals            AnalysisInfraSignal[]
  dimensionSignals        DimensionSignal[] // Signals for each dimension

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([architectureType])
  @@index([engineeringLevel])
  @@index([analyzedAt])
  @@index([trustLevel])
  @@map("project_analyses")
}

// ==================== REACT-SPECIFIC ANALYSIS ====================

model ReactAnalysis {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  analysisId String @unique @map("analysis_id") @db.ObjectId

  // ========== REACT PATTERNS ==========
  usesHooks         Boolean @default(false) @map("uses_hooks")
  usesContext       Boolean @default(false) @map("uses_context")
  usesReducer       Boolean @default(false) @map("uses_reducer")
  usesMemo          Boolean @default(false) @map("uses_memo")
  usesCallback      Boolean @default(false) @map("uses_callback")
  usesRef           Boolean @default(false) @map("uses_ref")
  usesLazyLoading   Boolean @default(false) @map("uses_lazy_loading")
  usesErrorBoundary Boolean @default(false) @map("uses_error_boundary")

  // ========== METRICS ==========
  componentCount   Int     @default(0) @map("component_count")
  customHooksCount Int     @default(0) @map("custom_hooks_count")
  stateManagement  String? @map("state_management") // "Context", "Redux", "Zustand"

  // ========== PATTERNS & SUGGESTIONS ==========
  patternsDetected String[] @default([]) @map("patterns_detected")
  advancedUsage    String[] @default([]) @map("advanced_usage")
  suggestions      String[] @default([])

  analysis ProjectAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@map("react_analyses")
}

model AnalysisLanguageStat {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  analysisId String @map("analysis_id") @db.ObjectId

  name       String
  lines      Int    @default(0)
  files      Int    @default(0)
  percentage Float  @default(0)

  analysis ProjectAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId])
  @@map("analysis_language_stats")
}

model AnalysisInfraSignal {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  analysisId String @map("analysis_id") @db.ObjectId

  signal     String
  confidence Float?   @default(0)
  source     String?
  evidence   String[] @default([])

  analysis ProjectAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId])
  @@map("analysis_infra_signals")
}

// ==================== VERIFIED SKILLS ====================

model AnalysisVerifiedSkill {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  analysisId String @map("analysis_id") @db.ObjectId

  name          String
  category      SkillCategory
  confidence    Float // 0.0 to 1.0
  auraPoints    Int           @default(0) @map("aura_points")
  resumeReady   Boolean       @default(false) @map("resume_ready")
  usageVerified Boolean       @default(false) @map("usage_verified")
  usageStrength Float         @default(0.0) @map("usage_strength")
  evidence      String[]      @default([])
  richEvidence  Json?         @map("rich_evidence") // Phase 6: Granular pattern-based evidence
  linesOfCode   Int?          @map("lines_of_code")

  analysis ProjectAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId])
  @@index([category])
  @@index([confidence])
  @@map("analysis_verified_skills")
}

// ==================== OPTIMIZATIONS ====================

model AnalysisOptimization {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  analysisId String @map("analysis_id") @db.ObjectId

  category    OptimizationCategory
  priority    OptimizationPriority
  title       String
  description String
  impact      String

  analysis ProjectAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId])
  @@index([priority])
  @@map("analysis_optimizations")
}

// ==================== DIMENSION SIGNALS (NEW) ====================
// Stores evidence signals for each dimension

model DimensionSignal {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  analysisId String @map("analysis_id") @db.ObjectId

  dimension DimensionType // Which dimension this signal belongs to
  signal    String // e.g., "has_docker", "uses_interfaces", "test_coverage_high"
  weight    Float         @default(1.0) // How much this contributes to the score
  evidence  String[]      @default([]) // File paths or code locations

  analysis ProjectAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId])
  @@index([dimension])
  @@map("dimension_signals")
}

// ==================== JOB MATCH RESULTS (NEW) ====================
// Stores results of candidate-job matching

model JobMatchResult {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  jobId      String @map("job_id") @db.ObjectId
  userId     String @map("user_id") @db.ObjectId
  analysisId String @map("analysis_id") @db.ObjectId

  // Overall Fit
  overallFit FitCategory
  matchScore Float       @default(0) @map("match_score") // 0-100
  confidence Float       @default(0) // 0-1

  // Dimension Match Breakdown
  dimFundamentalsFit   Float    @default(0) @map("dim_fundamentals_fit")
  dimEngineeringFit    Float // ========== AI VERDICT (Gemini) ==========
  aiVerdictTitle       String?  @map("ai_verdict_title")
  aiVerdictSummary     String?  @map("ai_verdict_summary")
  aiVerdictStrengths   String[] @default([]) @map("ai_verdict_strengths")
  aiVerdictWeaknesses  String[] @default([]) @map("ai_verdict_weaknesses")
  aiHireRecommendation String?  @map("ai_hire_recommendation") // STRONG_HIRE, HIRE, MAYBE, NO
  aiRiskScore          Int?     @map("ai_risk_score")
  aiRiskAnalysis       String?  @map("ai_risk_analysis")
  aiSkillsNarrative    String?  @map("ai_skills_narrative")
  aiInterviewQuestions String[] @default([]) @map("ai_interview_questions")

  // Level Match
  candidateLevel String? @map("candidate_level")
  levelStatus    String? @map("level_status") // EXCEEDS, MEETS, BELOW
  levelGap       Int     @default(0) @map("level_gap")

  // Recruiter Guidance
  strengths      String[] @default([])
  concerns       String[] @default([])
  interviewFocus String[] @default([]) @map("interview_focus")
  recommendation String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([jobId, userId])
  @@index([jobId])
  @@index([userId])
  @@index([overallFit])
  @@index([matchScore])
  @@map("job_match_results")
}

