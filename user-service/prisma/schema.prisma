// ==================== JOB APPLICATION MODELS ====================

model Application {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @map("user_id") @db.ObjectId
  jobId  String @map("job_id")

  // Job Information (denormalized for easier dashboard queries)
  companyName String @map("company_name")
  role        String

  // Application Details
  coverLetter String? @map("cover_letter")
  resumeUrl   String? @map("resume_url")

  // Status Tracking
  status        ApplicationStatus @default(PENDING)
  statusHistory Json              @default("[]") @map("status_history") // Array of {status, timestamp, note}
  currentStage  String?           @default("applied") @map("current_stage")

  // Matching
  matchScore     Float?  @default(0) @map("match_score") // 0-100
  auraMatch      Boolean @default(false) @map("aura_match")
  skillsMatched  Int     @default(0) @map("skills_matched")
  skillsRequired Int     @default(0) @map("skills_required")

  // Recruiter Interaction
  recruiterNotes String?   @map("recruiter_notes")
  rating         Int? // 1-5 stars
  isViewed       Boolean   @default(false) @map("is_viewed")
  viewedAt       DateTime? @map("viewed_at")

  // Timestamps
  appliedAt  DateTime  @default(now()) @map("applied_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  reviewedAt DateTime? @map("reviewed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([jobId, userId])
  @@index([userId])
  @@index([jobId])
  @@index([status])
  @@index([appliedAt(sort: Desc)])
  @@map("applications")
}

enum ApplicationStatus {
  PENDING
  REVIEWING
  SHORTLISTED
  INTERVIEW // Changed from INTERVIEW_SCHEDULED for consistency
  INTERVIEW_SCHEDULED
  INTERVIEW_COMPLETED
  OFFER // Added for offers
  OFFER_EXTENDED
  OFFER_ACCEPTED
  REJECTED
  WITHDRAWN
}

// ==================== SAVED JOBS ====================

model SavedJob {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @map("user_id") @db.ObjectId
  jobId  String @map("job_id")

  notes String? // Personal notes about the job

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId])
  @@index([createdAt(sort: Desc)])
  @@map("saved_jobs")
}

// ==================== JOB ALERTS ====================

model JobAlert {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @map("user_id") @db.ObjectId

  name String

  // Alert Criteria
  keywords     String[] @default([])
  roles        String[] @default([])
  locations    String[] @default([])
  jobTypes     String[] @default([])
  minSalary    Int?     @map("min_salary")
  maxSalary    Int?     @map("max_salary")
  remoteOnly   Boolean  @default(false) @map("remote_only")
  minAuraScore Int?     @map("min_aura_score")

  // Notification Settings
  isActive       Boolean   @default(true) @map("is_active")
  emailEnabled   Boolean   @default(true) @map("email_enabled")
  frequency      String    @default("daily") // instant, daily, weekly
  lastNotifiedAt DateTime? @map("last_notified_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
  @@map("job_alerts")
}

// ==================== NOTIFICATIONS ====================

model Notification {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @map("user_id") @db.ObjectId

  // Notification Content
  type    NotificationType
  title   String
  message String
  link    String? // Optional link to relevant resource

  // Metadata
  metadata Json? // Additional data (jobId, applicationId, etc.)

  // Status
  isRead Boolean   @default(false) @map("is_read")
  readAt DateTime? @map("read_at")

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt(sort: Desc)])
  @@map("notifications")
}

enum NotificationType {
  JOB_MATCH
  APPLICATION_UPDATE
  INTERVIEW_SCHEDULED
  MESSAGE_RECEIVED
  PROFILE_VIEW
  PROJECT_ANALYZED
  AURA_UPDATE
  SYSTEM
}

// ==================== AURA SCORE TRACKING ====================

model AuraScore {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @unique @map("user_id") @db.ObjectId

  // Total score
  totalScore Int @default(0) @map("total_score")

  // Breakdown by category
  profileScore   Int @default(0) @map("profile_score")
  projectScore   Int @default(0) @map("project_score")
  skillScore     Int @default(0) @map("skill_score")
  activityScore  Int @default(0) @map("activity_score")
  githubScore    Int @default(0) @map("github_score")
  communityScore Int @default(0) @map("community_score")

  // Trend tracking
  monthlyChange Int @default(0) @map("monthly_change") // +/- change in last 30 days
  loginStreak   Int @default(0) @map("login_streak") // Consecutive days

  // Timestamps
  lastCalculated DateTime @default(now()) @map("last_calculated")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  gainHistory AuraGainHistory[]

  @@index([totalScore])
  @@map("aura_scores")
}

model AuraGainHistory {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  auraScoreId String   @map("aura_score_id") @db.ObjectId
  type        String // 'PROJECT_ANALYZED' | 'SKILL_VERIFIED' | 'GITHUB_ACTIVITY' | 'LOGIN' | 'PROFILE_UPDATE'
  points      Int
  description String
  createdAt   DateTime @default(now()) @map("created_at")

  auraScore AuraScore @relation(fields: [auraScoreId], references: [id], onDelete: Cascade)

  @@index([auraScoreId])
  @@index([createdAt])
  @@map("aura_gain_history")
}
