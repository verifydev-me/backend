# ============================================
# VERIFY BACKEND - ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and replace with real values
# NEVER commit .env to version control!
#
# For local development, you can use:
#   cp .env.example .env
#   Then update DATABASE_URL and GITHUB credentials

# ==================== DATABASE ====================
# MongoDB Atlas Connection String
DATABASE_URL=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/verifydev?retryWrites=true&w=majority

# Chat Service MongoDB (can be same or separate)
CHAT_DATABASE_URL=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/verifydev_chat?retryWrites=true&w=majority

# ==================== GITHUB OAUTH ====================
# Create OAuth App at: https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:80/api/v1/auth/github/callback

# Personal Access Token for repo cloning (optional, for private repos)
GITHUB_TOKEN=

# ==================== JWT SECRETS ====================
# Generate with: openssl rand -base64 32
# MUST be at least 32 characters!
JWT_ACCESS_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_32
JWT_REFRESH_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_32

# ==================== REDIS ====================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ==================== RABBITMQ ====================
# For development, use simple credentials
# For production, use strong passwords!
RABBITMQ_USER=verifydev
RABBITMQ_PASS=verifydev_dev_password
RABBITMQ_URL=amqp://verifydev:verifydev_dev_password@rabbitmq:5672

# ==================== CLOUDINARY ====================
# For avatar/image uploads
# Get from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ==================== CORS ====================
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# ==================== ENVIRONMENT ====================
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ==================== SERVICE PORTS ====================
AUTH_SERVICE_PORT=3001
USER_SERVICE_PORT=3002
JOB_SERVICE_PORT=3004
RECRUITER_SERVICE_PORT=3005
CHAT_SERVICE_PORT=3006
ANALYZER_SERVICE_PORT=8001
RESUME_SERVICE_PORT=8003
GATEWAY_PORT=8000

