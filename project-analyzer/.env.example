# Server
PORT=8001
ENV=development

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Exchanges & Queues
EXCHANGE_NAME=project.events
CONSUME_QUEUE=project.analyze.request
PUBLISH_QUEUE=project.analyzed

# Analyzer Config
CLONE_DIR=/tmp/repos
MAX_REPO_SIZE_MB=100
ANALYSIS_TIMEOUT_SEC=120

# Worker Pool Configuration (for concurrent processing)
# Number of concurrent workers (recommended: 2-8 based on CPU cores)
WORKER_COUNT=4
# RabbitMQ prefetch count (should match WORKER_COUNT)
PREFETCH_COUNT=4

# GitHub (for private repos - optional)
GITHUB_TOKEN=

