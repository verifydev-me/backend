// ==================== PROJECT ANALYSIS MODEL (STRUCTURED) ====================
// Complete structured schema - NO JSON fields!
// All analysis data as proper database fields for better querying and performance

model ProjectAnalysis {
    id        String @id @default(auto()) @map("_id") @db.ObjectId
    projectId String @unique @map("project_id") @db.ObjectId

    // ========== METADATA ==========
    analyzerVersion String   @default("2.0.0") @map("analyzer_version")
    processingTime  Int?     @map("processing_time") // milliseconds
    analyzedAt      DateTime @default(now()) @map("analyzed_at")

    // ========== FOLDER STRUCTURE ==========
    hasSrcFolder      Boolean  @default(false) @map("has_src_folder")
    hasComponents     Boolean  @default(false) @map("has_components")
    hasUtils          Boolean  @default(false) @map("has_utils")
    hasTests          Boolean  @default(false) @map("has_tests")
    hasTypes          Boolean  @default(false) @map("has_types")
    hasConfig         Boolean  @default(false) @map("has_config")
    hasDocs           Boolean  @default(false) @map("has_docs")
    hasApi            Boolean  @default(false) @map("has_api")
    hasServices       Boolean  @default(false) @map("has_services")
    hasModels         Boolean  @default(false) @map("has_models")
    hasMiddleware     Boolean  @default(false) @map("has_middleware")
    hasControllers    Boolean  @default(false) @map("has_controllers")
    organizationScore Int      @default(0) @map("organization_score")
    maxDepth          Int      @default(0) @map("max_depth")
    topLevelFolders   String[] @default([]) @map("top_level_folders")

    // ========== CODE QUALITY SIGNALS ==========
    hasReadme        Boolean @default(false) @map("has_readme")
    hasLicense       Boolean @default(false) @map("has_license")
    hasGitignore     Boolean @default(false) @map("has_gitignore")
    hasEnvExample    Boolean @default(false) @map("has_env_example")
    hasDockerfile    Boolean @default(false) @map("has_dockerfile")
    hasDockerCompose Boolean @default(false) @map("has_docker_compose")
    hasCI            Boolean @default(false) @map("has_ci")
    ciPlatform       String? @map("ci_platform") // "GitHub Actions", "GitLab CI", etc.
    hasLinting       Boolean @default(false) @map("has_linting")
    hasPrettier      Boolean @default(false) @map("has_prettier")
    hasTypeScript    Boolean @default(false) @map("has_typescript")
    hasMakefile      Boolean @default(false) @map("has_makefile")
    testFilesCount   Int     @default(0) @map("test_files_count")
    commentDensity   Int     @default(0) @map("comment_density")

    // ========== PROJECT METRICS ==========
    totalLines      Int    @default(0) @map("total_lines")
    totalFiles      Int    @default(0) @map("total_files")
    primaryLanguage String @default("Unknown") @map("primary_language")

    // ========== TECH STACK ==========
    languages      String[] @default([]) // ["TypeScript", "JavaScript"]
    frameworks     String[] @default([]) // ["React", "Express"]
    databases      String[] @default([]) // ["MongoDB", "Redis"]
    tools          String[] @default([]) // ["Docker", "Vite"]
    infrastructure String[] @default([]) // ["Nginx", "RabbitMQ"]

    // ========== ARCHITECTURE ==========
    architectureType   ArchitectureType? @map("architecture_type")
    serviceCount       Int               @default(0) @map("service_count")
    hasAPIGateway      Boolean           @default(false) @map("has_api_gateway")
    hasMessageQueue    Boolean           @default(false) @map("has_message_queue")
    hasSharedLibraries Boolean           @default(false) @map("has_shared_libraries")
    engineeringLevel   EngineeringLevel? @map("engineering_level")

    // ========== BEST PRACTICES ==========
    bestPracticesFollowed String[] @default([]) @map("best_practices_followed")
    bestPracticesMissing  String[] @default([]) @map("best_practices_missing")
    bestPracticesScore    Int      @default(0) @map("best_practices_score")

    // ========== SCORES (from breakdown) ==========
    structureScore     Int @default(0) @map("structure_score")
    codeQualityScore   Int @default(0) @map("code_quality_score")
    testingScore       Int @default(0) @map("testing_score")
    documentationScore Int @default(0) @map("documentation_score")
    techStackScore     Int @default(0) @map("tech_stack_score")
    complexityScore    Int @default(0) @map("complexity_score")
    industryBonus      Int @default(0) @map("industry_bonus")
    projectTypeBonus   Int @default(0) @map("project_type_bonus")

    // ========== RELATIONS ==========
    project                 Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
    verifiedSkills          AnalysisVerifiedSkill[]
    optimizationSuggestions AnalysisOptimization[]
    reactAnalysis           ReactAnalysis?

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@index([projectId])
    @@index([architectureType])
    @@index([engineeringLevel])
    @@index([analyzedAt])
    @@map("project_analyses")
}

// ==================== VERIFIED SKILLS (from Analysis) ====================

model AnalysisVerifiedSkill {
    id         String @id @default(auto()) @map("_id") @db.ObjectId
    analysisId String @map("analysis_id") @db.ObjectId

    name        String
    category    SkillCategory
    confidence  Float // 0.0 to 1.0
    auraPoints  Int           @default(0) @map("aura_points")
    resumeReady Boolean       @default(false) @map("resume_ready")
    evidence    String[]      @default([])
    linesOfCode Int?          @map("lines_of_code")

    analysis ProjectAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

    @@index([analysisId])
    @@index([category])
    @@index([confidence])
    @@map("analysis_verified_skills")
}

// ==================== OPTIMIZATION SUGGESTIONS ====================

model AnalysisOptimization {
    id         String @id @default(auto()) @map("_id") @db.ObjectId
    analysisId String @map("analysis_id") @db.ObjectId

    category    OptimizationCategory
    priority    OptimizationPriority
    title       String
    description String
    impact      String

    analysis ProjectAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

    @@index([analysisId])
    @@index([priority])
    @@map("analysis_optimizations")
}

// ==================== REACT-SPECIFIC ANALYSIS ====================

model ReactAnalysis {
    id         String @id @default(auto()) @map("_id") @db.ObjectId
    analysisId String @unique @map("analysis_id") @db.ObjectId

    // ========== REACT PATTERNS ==========
    usesHooks         Boolean @default(false) @map("uses_hooks")
    usesContext       Boolean @default(false) @map("uses_context")
    usesReducer       Boolean @default(false) @map("uses_reducer")
    usesMemo          Boolean @default(false) @map("uses_memo")
    usesCallback      Boolean @default(false) @map("uses_callback")
    usesRef           Boolean @default(false) @map("uses_ref")
    usesLazyLoading   Boolean @default(false) @map("uses_lazy_loading")
    usesErrorBoundary Boolean @default(false) @map("uses_error_boundary")

    // ========== METRICS ==========
    componentCount   Int     @default(0) @map("component_count")
    customHooksCount Int     @default(0) @map("custom_hooks_count")
    stateManagement  String? @map("state_management") // "Context", "Redux", "Zustand"

    // ========== PATTERNS & SUGGESTIONS ==========
    patternsDetected String[] @default([]) @map("patterns_detected")
    advancedUsage    String[] @default([]) @map("advanced_usage")
    suggestions      String[] @default([])

    analysis ProjectAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

    @@index([analysisId])
    @@map("react_analyses")
}

// ==================== ENUMS ====================

enum ArchitectureType {
    MICROSERVICES
    MONOLITH
    MODULAR_MONOLITH
    MONOREPO
    EVENT_DRIVEN
    LAYERED
    CLEAN_ARCHITECTURE
    HEXAGONAL
    SERVERLESS
    UNKNOWN
}

enum EngineeringLevel {
    BEGINNER // "Beginner"
    INTERMEDIATE // "Intermediate"
    ADVANCED // "Advanced"
    PRODUCTION // "Production-grade"
}

enum OptimizationCategory {
    PERFORMANCE
    SECURITY
    TESTING
    DOCUMENTATION
    STRUCTURE
    SCALABILITY
}

enum OptimizationPriority {
    LOW
    MEDIUM
    HIGH
    CRITICAL
}
