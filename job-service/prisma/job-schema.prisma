// Job-related Prisma schema extension
// Add this to your main schema.prisma

/**
 * // ==================== JOB MODELS ====================
 * model Job {
 * id              String          @id @default(uuid())
 * // Organization/Recruiter who posted
 * organizationId  String
 * organization    Organization    @relation(fields: [organizationId], references: [id])
 * postedById      String
 * // Job Details
 * title           String
 * description     String          @db.Text
 * requirements    String          @db.Text
 * responsibilities String         @db.Text
 * // Classification
 * type            JobType         @default(FULL_TIME)
 * level           ExperienceLevel @default(MID)
 * location        String
 * isRemote        Boolean         @default(false)
 * // Compensation
 * salaryMin       Int?
 * salaryMax       Int?
 * salaryCurrency  String          @default("USD")
 * salaryPeriod    String          @default("yearly") // yearly, monthly, hourly
 * // Requirements
 * requiredSkills  JobSkill[]
 * minAuraScore    Int             @default(0)
 * minCoreCount    Int             @default(1)
 * // Status
 * status          JobStatus       @default(ACTIVE)
 * applicationsCount Int           @default(0)
 * viewsCount      Int             @default(0)
 * // Timestamps
 * createdAt       DateTime        @default(now())
 * updatedAt       DateTime        @updatedAt
 * expiresAt       DateTime?
 * // Relations
 * applications    Application[]
 * @@index([organizationId])
 * @@index([status])
 * @@index([type])
 * @@index([level])
 * }
 * model JobSkill {
 * id          String   @id @default(uuid())
 * jobId       String
 * job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
 * skillName   String
 * minScore    Int      @default(0)  // Minimum verified score required
 * isRequired  Boolean  @default(true)
 * @@index([jobId])
 * }
 * model Application {
 * id            String            @id @default(uuid())
 * // References
 * jobId         String
 * job           Job               @relation(fields: [jobId], references: [id])
 * userId        String
 * user          User              @relation(fields: [userId], references: [id])
 * // Application Details
 * coverLetter   String?           @db.Text
 * resumeUrl     String?
 * // Status
 * status        ApplicationStatus @default(PENDING)
 * // Recruiter Notes
 * recruiterNotes String?         @db.Text
 * rating        Int?              // 1-5 stars
 * // Timestamps
 * appliedAt     DateTime          @default(now())
 * updatedAt     DateTime          @updatedAt
 * reviewedAt    DateTime?
 * @@unique([jobId, userId]) // Can only apply once
 * @@index([jobId])
 * @@index([userId])
 * @@index([status])
 * }
 * model Organization {
 * id            String   @id @default(uuid())
 * // Basic Info
 * name          String
 * slug          String   @unique
 * logo          String?
 * website       String?
 * description   String?  @db.Text
 * // Location
 * headquarters  String?
 * // Company Details
 * industry      String?
 * size          CompanySize @default(SMALL)
 * foundedYear   Int?
 * // Verification
 * isVerified    Boolean  @default(false)
 * // Timestamps
 * createdAt     DateTime @default(now())
 * updatedAt     DateTime @updatedAt
 * // Relations
 * jobs          Job[]
 * recruiters    Recruiter[]
 * }
 * model Recruiter {
 * id              String       @id @default(uuid())
 * // Auth (separate from User for now - could be unified later)
 * email           String       @unique
 * passwordHash    String
 * // Profile
 * name            String
 * title           String?
 * phone           String?
 * avatarUrl       String?
 * // Organization
 * organizationId  String
 * organization    Organization @relation(fields: [organizationId], references: [id])
 * role            RecruiterRole @default(RECRUITER)
 * // Status
 * isActive        Boolean      @default(true)
 * // Timestamps
 * createdAt       DateTime     @default(now())
 * lastLoginAt     DateTime?
 * @@index([organizationId])
 * }
 * // ==================== ENUMS ====================
 * enum JobType {
 * FULL_TIME
 * PART_TIME
 * CONTRACT
 * INTERNSHIP
 * FREELANCE
 * }
 * enum ExperienceLevel {
 * ENTRY
 * JUNIOR
 * MID
 * SENIOR
 * LEAD
 * PRINCIPAL
 * }
 * enum JobStatus {
 * DRAFT
 * ACTIVE
 * PAUSED
 * CLOSED
 * EXPIRED
 * }
 * enum ApplicationStatus {
 * PENDING
 * REVIEWING
 * SHORTLISTED
 * INTERVIEW
 * OFFER
 * REJECTED
 * WITHDRAWN
 * }
 * enum CompanySize {
 * STARTUP     // 1-10
 * SMALL       // 11-50
 * MEDIUM      // 51-200
 * LARGE       // 201-1000
 * ENTERPRISE  // 1000+
 * }
 * enum RecruiterRole {
 * ADMIN       // Can manage org settings
 * RECRUITER   // Can post jobs, review applications
 * VIEWER      // Can only view
 * }
 */
