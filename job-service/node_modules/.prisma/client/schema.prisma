generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ==================== JOB MODELS ====================

model Job {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // ========== ORGANIZATION INFO (Denormalized) ==========
  organizationId   String  @map("organization_id") @db.ObjectId
  organizationName String? @map("organization_name") // Denormalized for performance
  recruiterId      String  @map("recruiter_id") @db.ObjectId

  // ========== JOB DETAILS ==========
  title            String
  description      String
  shortDescription String? @map("short_description")
  requirements     String?
  responsibilities String?

  // ========== CLASSIFICATION ==========
  jobType         JobType         @default(FULL_TIME) @map("job_type")
  experienceLevel ExperienceLevel @default(MID) @map("experience_level")
  location        String?
  locationType    LocationType    @default(ONSITE) @map("location_type")

  // ========== COMPENSATION ==========
  salaryMin      Int?   @map("salary_min")
  salaryMax      Int?   @map("salary_max")
  salaryCurrency String @default("INR") @map("salary_currency")

  // ========== REQUIREMENTS ==========
  minAuraScore Int @default(0) @map("min_aura_score")
  minCoreCount Int @default(1) @map("min_core_count")

  // ========== STATUS & METRICS ==========
  status            JobStatus @default(ACTIVE)
  applicationsCount Int       @default(0) @map("applications_count")
  viewsCount        Int       @default(0) @map("views_count")

  // ========== TIMESTAMPS ==========
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  expiresAt DateTime? @map("expires_at")

  // ========== RELATIONS ==========
  requiredSkills JobSkill[]
  applications   Application[]

  @@index([organizationId])
  @@index([recruiterId])
  @@index([status])
  @@index([jobType])
  @@index([experienceLevel])
  @@index([locationType])
  @@index([createdAt(sort: Desc)])
  @@index([minAuraScore])
  @@index([expiresAt])
  @@index([status, createdAt(sort: Desc)])
  @@map("jobs")
}

// ==================== JOB SKILL REQUIREMENTS ====================

model JobSkill {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  jobId      String  @map("job_id") @db.ObjectId
  skillName  String  @map("skill_name")
  minScore   Int     @default(0) @map("min_score") // Minimum proficiency required (0-100)
  isRequired Boolean @default(false) @map("is_required") // Must-have vs nice-to-have

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, skillName])
  @@index([jobId])
  @@index([skillName])
  @@index([isRequired])
  @@map("job_skills")
}

// ==================== APPLICATION MODEL ====================

model Application {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // ========== REFERENCES ==========
  jobId  String @map("job_id") @db.ObjectId
  userId String @map("user_id") @db.ObjectId // References user-service User

  // ========== APPLICATION DETAILS ==========
  coverLetter    String? @map("cover_letter")
  resumeUrl      String? @map("resume_url")
  resumeSnapshot Json?   @map("resume_snapshot") // Copy of resume data at apply time

  // ========== MATCH SCORE (calculated at apply time) ==========
  matchScore     Int   @default(0) @map("match_score") // 0-100
  matchBreakdown Json? @map("match_breakdown") // Detailed skill matching breakdown

  // ========== STATUS ==========
  status ApplicationStatus @default(PENDING)

  // ========== RECRUITER FEEDBACK ==========
  recruiterNotes String? @map("recruiter_notes")
  rating         Int? // 1-5 stars

  // ========== TIMESTAMPS ==========
  appliedAt  DateTime  @default(now()) @map("applied_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  reviewedAt DateTime? @map("reviewed_at")

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, userId]) // Can only apply once per job
  @@index([jobId])
  @@index([userId])
  @@index([status])
  @@index([appliedAt(sort: Desc)])
  @@index([matchScore(sort: Desc)])
  @@index([jobId, status])
  @@index([userId, status])
  @@map("applications")
}

// ==================== ENUMS ====================

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  FREELANCE
}

enum LocationType {
  ONSITE
  REMOTE
  HYBRID
}

enum ExperienceLevel {
  ENTRY // 0-1 years
  JUNIOR // 1-2 years
  MID // 2-5 years
  SENIOR // 5-8 years
  LEAD // 8+ years
  PRINCIPAL // 10+ years
}

enum JobStatus {
  DRAFT // Not yet published
  ACTIVE // Accepting applications
  PAUSED // Temporarily not accepting
  CLOSED // Filled or ended
  EXPIRED // Past deadline
}

enum ApplicationStatus {
  PENDING // Just applied
  REVIEWING // Being reviewed
  SHORTLISTED // In shortlist
  INTERVIEW // Interview scheduled
  OFFER // Job offered
  REJECTED // Not selected
  WITHDRAWN // Candidate withdrew
}
